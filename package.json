{
  "name": "website-auditor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "prod": "next start -H 0.0.0.0 -p 3100",
    "start": "next start -H 0.0.0.0 -p 3100",
    "worker": "tsx worker/index.ts",
    "dev:all": "concurrently -k 'npm run dev' 'npm run worker'",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "scan": "tsx cli/index.ts scan",
    "scan:status": "tsx cli/index.ts status",
    "scan:retry": "tsx cli/index.ts retry",
    "doctor": "tsx cli/index.ts doctor",
    "live": "tsx cli/live.ts",
    "routes:import": "tsx cli/index.ts import",
    "fixture": "node scripts/fixture-server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:files": "prettier --write",
    "lint:fix": "eslint . --fix",
    "quality:check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "worker:status": "fish scripts/worker-status.fish",
    "worker:install": "fish scripts/auditor.fish install",
    "worker:manage": "fish scripts/auditor.fish",
    "test:auth:browser": "node --import tsx tests/auth-browser.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "dotenv": "^16.6.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.20.0",
    "next": "^16.0.0",
    "playwright": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "eslint-config-prettier": "10.1.8"
  }
}
