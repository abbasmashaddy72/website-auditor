# Next.js target port; Lerd also injects PORT=3100 via its proxy config.
PORT=3100

# Host-native application (NOT lerd-mongo:27017, which is internal to container network)
MONGO_URI=mongodb://root:lerd@127.0.0.1:27017/?authSource=admin
MONGO_DATABASE=website_auditor
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=website-auditor-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Generate the next two values separately with openssl rand -hex 32
AUDITOR_ADMIN_PASSWORD=
SESSION_SECRET=
AUTH_ENCRYPTION_KEY=
# Explicit non-loopback destinations are checked against site scope.
WORKER_ID=
WORKER_LEASE_SECONDS=120
WORKER_POLL_MS=1500
DEFAULT_MAX_PAGES=50
DEFAULT_CONCURRENCY=2
# Development hosts should trust the Lerd CA; per-site ignoreHTTPSErrors only by opt-in.

# Optional: explicit root for reading or patching associated local source projects.
# Leave blank to disable all source-code inspection and patch application.
LOCAL_SOURCE_ROOT=

# 0 maxPages = Auto. Auto is always bounded by these safety ceilings.
AUTO_PAGE_SAFETY_LIMIT=10000
SCAN_TIME_BUDGET_MS=3600000
